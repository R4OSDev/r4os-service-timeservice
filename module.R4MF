R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=TIMESVC
VERSION=0.1.2
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/TIMESVC.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
META=service.name=TIMESVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:DATE_V1:1
IMPORT=R4STD:TIME_V1:1
IMPORT=R4STD:CONFIG_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
